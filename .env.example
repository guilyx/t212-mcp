# Copy to `.env` for local development. `.env` is git-ignored — never commit
# real credentials.
#
# Create a key in the Trading 212 app: Settings -> API. Practice and real
# accounts issue separate credentials; a key from one is rejected by the other.

# Required.
T212_API_KEY=

# Newer keys are issued as a key/secret pair and authenticate with HTTP Basic.
# Leave empty for an older single-token key, which is sent as the
# `Authorization` header on its own.
T212_API_SECRET=

# `demo` (practice money, the default) or `live` (real money).
T212_ENVIRONMENT=demo

# Optional overrides. Defaults shown.
#T212_BASE_URL=https://demo.trading212.com
#T212_TIMEOUT_MS=15000
#T212_MAX_RETRIES=3
#T212_CACHE_TTL_MS=300000
#T212_LOG_LEVEL=info

# Allows the CSV export tools, which create a report job on Trading 212's
# side. Every other tool is a pure read.
#T212_ALLOW_EXPORTS=false
